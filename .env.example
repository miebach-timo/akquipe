# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Obsidian Vault path (optional — defaults to output/vault/)
# VAULT_PATH=C:/Users/dein-name/Documents/ObsidianVault

# Output directory for all run artifacts (default: output/)
OUTPUT_DIR=output

# Playwright browser timeout in milliseconds (default: 30000)
SCRAPER_TIMEOUT=30000

# Max pages to crawl per site (default: 30)
SCRAPER_MAX_PAGES=30

# Max crawl depth (default: 3)
SCRAPER_MAX_DEPTH=3

# Freelancer day rate in EUR for pricing model
FREELANCER_DAY_RATE=800

# Claude model to use for audit (cost/quality balance)
AUDIT_MODEL=claude-sonnet-4-6

# Claude model to use for reconstruction (can use cheaper model)
RECONSTRUCT_MODEL=claude-haiku-4-5-20251001
